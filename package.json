{
  "name": "awakebar",
  "productName": "AwakeBar",
  "version": "1.0.0",
  "description": "A macOS menu bar app that keeps your Mac from going to sleep.",
  "keywords": [
    "electron",
    "macos",
    "menu-bar",
    "tray",
    "caffeine",
    "sleep"
  ],
  "license": "MIT",
  "author": {
    "name": "Ashish Ranjan",
    "url": "https://github.com/builtbyashish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/builtbyashish/awakebar.git"
  },
  "bugs": {
    "url": "https://github.com/builtbyashish/awakebar/issues"
  },
  "homepage": "https://github.com/builtbyashish/awakebar#readme",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "generate-icons": "node scripts/generate-tray-icons.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "electron": "45.0.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.89.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  }
}
